# Packages first - the analyser never has to guess the order.
# The serial monitor is instantiated inside 'if HAS_MONITOR generate' and does
# not exist on this board. The files still have to be here: Quartus resolves
# entity references in a NOT taken generate branch as well and errors with
# 10481 otherwise. Nothing is synthesised from them.
set_global_assignment -name VHDL_FILE ../../rtl/serial_api/WillFA7_Monitor.vhd
set_global_assignment -name VHDL_FILE ../../rtl/serial_api/uart_tx.vhd
set_global_assignment -name VHDL_FILE ../../rtl/serial_api/uart_rx.vhd
